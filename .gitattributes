# Normalize text files in the repository.
* text=auto eol=lf

# Lua
*.lua text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration / metadata
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts, if they appear later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Images and other binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Archives.
*.zip binary
*.7z binary
*.rar binary
